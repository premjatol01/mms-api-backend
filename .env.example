PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tablly
NODE_ENV=production
CORS_ORIGIN=https://mms-restaurant-web.vercel.app,https://mms-restaurant-admin.vercel.app,https://mms-super-admin.vercel.app
JWT_SECRET=your_jwt_secret_key

# Domain & Multi-Tenant Routing Configuration:
BASE_DOMAIN=mms-restaurant-web.vercel.app
ROUTING_MODE=path

# Cloudinary Storage Configuration (Free Cloud Image Hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Settings (SMTP)
