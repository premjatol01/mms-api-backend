PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tablly
NODE_ENV=production
CORS_ORIGIN=https://tablly-web.vercel.app,https://tablly-super-admin.vercel.app,https://tablly-restaurant-admin.vercel.app
JWT_SECRET=your_jwt_secret_key

# Domain & Multi-Tenant Routing Configuration:
# - For Free Testing on Vercel/Render: Set BASE_DOMAIN to your Vercel URL (e.g. tablly-web.vercel.app)
#   and set ROUTING_MODE=path so tables & menus generate https://tablly-web.vercel.app/{subdomain}/menu/{table}
# - For Production with Custom Wildcard Domain: Set BASE_DOMAIN=tablly.com and ROUTING_MODE=subdomain
BASE_DOMAIN=tablly-web.vercel.app
ROUTING_MODE=path

# Cloudinary Storage Configuration (Free Cloud Image Hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Settings (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Tablly Platform
FRONTEND_URL=https://tablly-web.vercel.app

# Meta WhatsApp Cloud API (Leave blank for Mock mode in terminal)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=tablly_otp
WHATSAPP_LANGUAGE_CODE=en_US
